{
  "opencollection": "1.0.0",
  "info": {
    "name": "Broadcom Operations for Applications REST Alerts Session API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Session",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Broadcom Create a session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.wavefront.com/api/v2/cis/session"
          },
          "docs": "Creates a session with the API using username and password credentials."
        },
        {
          "info": {
            "name": "Broadcom Delete a session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{instance}.wavefront.com/api/v2/cis/session"
          },
          "docs": "Terminates the current session."
        }
      ]
    }
  ],
  "bundled": true
}