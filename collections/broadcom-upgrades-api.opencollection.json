{
  "opencollection": "1.0.0",
  "info": {
    "name": "Broadcom Operations for Applications REST Alerts Upgrades API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Upgrades",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Broadcom List available upgrades",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.wavefront.com/api/v2/upgrades"
          },
          "docs": "Returns all available upgrades for the VCF system."
        }
      ]
    }
  ],
  "bundled": true
}