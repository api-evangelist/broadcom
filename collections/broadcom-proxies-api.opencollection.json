{
  "opencollection": "1.0.0",
  "info": {
    "name": "Broadcom Operations for Applications REST Alerts Proxies API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Proxies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Broadcom List proxies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.wavefront.com/api/v2/proxy"
          },
          "docs": "Returns all registered proxies."
        },
        {
          "info": {
            "name": "Broadcom Get a proxy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.wavefront.com/api/v2/proxy/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details of the specified proxy."
        },
        {
          "info": {
            "name": "Broadcom Delete a proxy",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{instance}.wavefront.com/api/v2/proxy/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes the specified proxy."
        }
      ]
    }
  ],
  "bundled": true
}